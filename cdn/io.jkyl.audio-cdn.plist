<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.jkyl.audio-cdn</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Volumes/Pandora/jkyl-audio/repo/cdn/run-server.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/tmp/audio-server.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/audio-server.log</string>
</dict>
</plist>
